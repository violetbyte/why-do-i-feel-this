---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '../styles/global.css';
import { svg } from '../lib/themes';

interface Props {
  title: string;
  description: string;
  og?: string;
  bodyClass?: string;
  nav?: 'home' | 'find' | 'saved' | null;
  type?: 'website' | 'article';
}
const { title, description, og = 'home', bodyClass = '', nav = null, type = 'website' } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`/og/${og}.png`, site).href;
const fullTitle = title === 'Why Do I Feel This' ? title : `${title} · Why Do I Feel This`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Why Do I Feel This" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#faf6f0" id="tc" />
    <script is:inline>
      (function () {
        var d = document.documentElement, m = null;
        try { m = localStorage.getItem('wdft-mode'); } catch (e) {}
        if (!m) m = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = m;
        document.getElementById('tc').content = m === 'dark' ? '#0f1122' : '#faf6f0';
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="sr" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/"><span class="dot" aria-hidden="true"></span>Why Do I Feel This</a>
        <nav class="nav" aria-label="Main">
          <a href="/find/" class="hide-sm" aria-current={nav === 'find' ? 'page' : undefined}>Find a feeling</a>
          <a href="/#saved" id="savedLink"><Fragment set:html={svg('bookmark')} /><span class="hide-sm">Saved</span><span class="badge" id="savedCount">0</span></a>
          <button class="icon-btn mode" id="mode" type="button" aria-label="Switch light or dark mode">
            <Fragment set:html={svg('moon', 'ic moon')} /><Fragment set:html={svg('sun', 'ic sun')} />
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div><b>Oh, that’s why.</b><br />Plain, gentle explanations for everyday feelings. Not medical advice.</div>
        <div><a href="/">All feelings</a> · <a href="/find/">Find a feeling</a></div>
      </div>
    </footer>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import { initChrome } from '../lib/client';
      initChrome();
    </script>
  </body>
</html>
